// Generated by lsc from indexedCallbacks.ts

function CallbackIndices(n: nat): (r: seq<int>)
  ensures |r| == n
  ensures forall i :: 0 <= i < n ==> r[i] == i
  ensures forall i :: i in r <==> 0 <= i < n
{
  if n == 0 then [] else CallbackIndices(n - 1) + [n - 1]
}

function pairwiseAtMost(a: seq<int>, b: seq<int>): bool
{
  ((|a| == |b|) && (var i_callbackSource0: seq<int> := a; Std.Collections.Seq.All(CallbackIndices(|i_callbackSource0|), (i_callbackIndex0: int) => (((0 <= i_callbackIndex0) && (i_callbackIndex0 < |i_callbackSource0|)) && (var x: int := i_callbackSource0[i_callbackIndex0]; (var i: int := i_callbackIndex0; (x <= b[i])))))))
}

function plusIndex(a: seq<int>): seq<int>
{
  var i_callbackSource1: seq<int> := a;
  seq(|i_callbackSource1|, i_map requires 0 <= i_map < |i_callbackSource1| => var i_callbackIndex1: int := i_map; (var x: int := i_callbackSource1[i_callbackIndex1]; (var i: int := i_callbackIndex1; (x + i))))
}

// Behavioral regressions for https://github.com/midspiral/LemmaScript/issues/288.
lemma IndexedCallbackExamples()
  ensures pairwiseAtMost([1, 2], [1, 3])
  ensures !pairwiseAtMost([1, 4], [1, 3])
  ensures pairwiseAtMost([], [])
  ensures !pairwiseAtMost([1], [])
  ensures plusIndex([10, 10, 10]) == [10, 11, 12]
  ensures plusIndex([]) == []
{
  reveal Std.Collections.Seq.All();
  assert 1 in CallbackIndices(2);
}
