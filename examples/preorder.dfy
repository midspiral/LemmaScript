// Generated by lsc from preorder.ts
//
// Hand-written proof scaffolding for the strong post-condition
//   `result == preorderTraversal(root)` on the iterative `traverseBasic`.
//
// Adapted from dafny-aoc-2025/preorder.dfy. The TS-side has the Tree
// datatype and the pure `preorderTraversal` / `childStack` helpers;
// the imperative method body comes from `lsc gen`. The supporting
// `StackToPreorder` helper and lemmas prove both functional equivalence
// and termination (`decreases |StackToPreorder(stack)|`) without needing
// any extra precondition beyond `root.Node?`.

datatype Tree = Nil | Node(val: int, left: Tree, right: Tree)

function preorderTraversal(root: Tree): seq<Tree>
{
  match root {
    case Nil =>
      []
    case Node(i_root_val, i_root_left, i_root_right) =>
      if ((!i_root_left.Nil?) && (!i_root_right.Nil?)) then
        (([root] + preorderTraversal(i_root_left)) + preorderTraversal(i_root_right))
      else
        if (!i_root_left.Nil?) then
          ([root] + preorderTraversal(i_root_left))
        else
          if (!i_root_right.Nil?) then
            ([root] + preorderTraversal(i_root_right))
          else
            [root]
  }
}

function childStack(node: Tree): seq<Tree>
{
  match node {
    case Nil =>
      []
    case Node(i_node_val, i_node_left, i_node_right) =>
      if (i_node_right.Node? && i_node_left.Node?) then
        [i_node_right, i_node_left]
      else
        if i_node_right.Node? then
          [i_node_right]
        else
          if i_node_left.Node? then
            [i_node_left]
          else
            []
  }
}

// ═════════════════════ Hand-written proof scaffolding ═════════════════════

function StackToPreorder(s: seq<Tree>): seq<Tree>
{
  if s == [] then []
  else preorderTraversal(s[|s| - 1]) + StackToPreorder(s[..|s| - 1])
}

lemma Lemma_StackToPreorder_App(a: seq<Tree>, b: seq<Tree>)
  ensures StackToPreorder(a + b) == StackToPreorder(b) + StackToPreorder(a)
{
  if b == [] {
    assert a + b == a;
  } else {
    assert a + b == a + b[..|b| - 1] + [b[|b| - 1]];
    Lemma_StackToPreorder_App(a, b[..|b| - 1]);
  }
}

lemma Lemma_PreserveInvariant(prefix: seq<Tree>, current: Tree)
  requires !current.Nil?
  ensures [current] + StackToPreorder(prefix + childStack(current))
       == StackToPreorder(prefix + [current])
{
  var children := childStack(current);
  Lemma_StackToPreorder_App(prefix, children);
  Lemma_StackToPreorder_App(prefix, [current]);
  // Reduce to [current] + StackToPreorder(childStack) == preorderTraversal(current),
  // case-split on childStack's four shapes so the small StackToPreorder unfoldings
  // are explicit (avoids a blind seq-concat search — was the file's slow VC).
  assert [current] + StackToPreorder(children) == preorderTraversal(current) by {
    if current.right.Node? && current.left.Node? {
      assert children == [current.right, current.left];
      assert [current.right, current.left][..1] == [current.right];
      assert [current.right][..0] == [];
    } else if current.right.Node? {
      assert children == [current.right];
      assert [current.right][..0] == [];
    } else if current.left.Node? {
      assert children == [current.left];
      assert [current.left][..0] == [];
    } else {
      assert children == [];
    }
  }
}

// ═════════════════════ Generated method (hand-annotated) ═════════════════════

method traverseBasic(root: Tree) returns (res: seq<Tree>)
  requires root.Node?
  ensures (res == preorderTraversal(root))
{
  var result: seq<Tree> := [];
  var stack := [root];
  assert stack[..0] == [];
  while (|stack| > 0)
    invariant forall s: Tree :: ((s in stack) ==> s.Node?)
    invariant result + StackToPreorder(stack) == preorderTraversal(root)
    decreases |StackToPreorder(stack)|
  {
    var current := stack[(|stack| - 1)];
    assert current in stack;
    assert stack == stack[..|stack| - 1] + [stack[|stack| - 1]];
    Lemma_PreserveInvariant(stack[..|stack| - 1], current);
    assert result + [current] + StackToPreorder(stack[..|stack| - 1] + childStack(current))
         == preorderTraversal(root);
    var i_t0 := childStack(current);
    stack := (stack[0..(|stack| - 1)] + i_t0);
    result := (result + [current]);
  }
  return result;
}
