  ensures (value.Null? ==> (classifyNullish(value) == 1))
  ensures (value.Undefined? ==> (classifyNullish(value) == 2))
  ensures (value.Value? ==> (classifyNullish(value) == (value.value + 10)))
{
}

function defaultNullish(value: Nullish<int>, fallback: int): int
