datatype Option<T> = None | Some(value: T)

datatype Nullish<T> = Undefined | Null | Value(value: T)

function classifyNullish(value: Nullish<int>): int
{
  if value.Null? then
    1
  else
    if value.Undefined? then
      2
    else
      (value.value + 10)
}

