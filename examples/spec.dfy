method assertInMap(m: map<string, int>, k: string, fallback: int) returns (res: int)
  ensures ((k in m) ==> (Option.Some(res) == (if k in m then Some(m[k]) else None)))
  ensures (!((k in m)) ==> (res == fallback))
{
  if !((k in m)) {
    return fallback;
  }
  assert (k in m);
  return m[k];
}

method whileInvariantInMap(m: map<string, int>, k: string, reps: nat) returns (res: int)
  requires (k in m)
  ensures (res == (m[k] * reps))
{
  var total := 0;
  var i := 0;
  while (i < reps)
    invariant (k in m)
    invariant (i <= reps)
    invariant (total == (m[k] * i))
    decreases (reps - i)
  {
    total := (total + m[k]);
    i := (i + 1);
  }
  return total;
}

