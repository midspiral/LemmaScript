method whileInvariantInMap(m: map<string, int>, k: string, reps: nat) returns (res: int)
  requires (k in m)
  ensures (res == (m[k] * reps))
{
  var total := 0;
  var i := 0;
  while (i < reps)
    invariant (k in m)
    invariant (i <= reps)
    invariant (total == (m[k] * i))
    decreases (reps - i)
  {
    total := (total + m[k]);
    i := (i + 1);
  }
  return total;
}

