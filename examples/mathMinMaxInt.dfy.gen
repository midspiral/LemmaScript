  ensures (lowestNatural(a, b, c) <= b)
  ensures (lowestNatural(a, b, c) <= c)
  ensures (((lowestNatural(a, b, c) == a) || (lowestNatural(a, b, c) == b)) || (lowestNatural(a, b, c) == c))
