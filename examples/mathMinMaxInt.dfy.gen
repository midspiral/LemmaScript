function highestInteger(a: int, b: int, c: int): int
{
  MathMax(MathMax(a, b), c)
}

lemma highestInteger_ensures(a: int, b: int, c: int)
  ensures (highestInteger(a, b, c) >= a)
  ensures (highestInteger(a, b, c) >= b)
  ensures (highestInteger(a, b, c) >= c)
  ensures (((highestInteger(a, b, c) == a) || (highestInteger(a, b, c) == b)) || (highestInteger(a, b, c) == c))
{
}

function lowestNatural(a: nat, b: nat, c: nat): nat
{
  MathMin(MathMin(a, b), c)
}

