}

function priceOrder(order: Order): Result<int, string>
{
  var checked := flatMap(checkQuantity(order), checkPrice);
  map_(checked, (valid: Order) => (valid.quantity * valid.unitPrice))
}

lemma priceOrder_ensures(order: Order)
