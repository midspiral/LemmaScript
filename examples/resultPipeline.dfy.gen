function checkPrice(order: Order): Result<Order, string>
{
  if (order.unitPrice < 0) then
    fail("invalid price")
  else
    succeed(order)
}

lemma checkPrice_ensures(order: Order)
  ensures ((order.unitPrice < 0) ==> (checkPrice(order).Failure? && (checkPrice(order).failure == "invalid price")))
  ensures ((order.unitPrice >= 0) ==> (checkPrice(order).Success? && (checkPrice(order).success == order)))
