// Generated by lsc from asyncApproval.ts

method {:axiom} askUser(reason: string) returns (res: Outcome)

datatype Mode = read_only | workspace_write | full_access

datatype Outcome = allowed_once | rejected | cancelled

datatype Request = Request(requested: Mode, effective: Mode, justification: string)

function rank(m: Mode): int
{
  if m.read_only? then
    0
  else
    if m.workspace_write? then
      1
    else
      2
}

lemma rank_ensures(m: Mode)
  ensures (0 <= rank(m))
  ensures (rank(m) <= 2)
{
}

method approve(request: Request) returns (res: Mode)
  ensures ((res == request.effective) || (rank(res) > rank(request.effective)))
{
  var requested := request.requested;
  var effective := request.effective;
  var justification := request.justification;
  if (requested == effective) {
    return effective;
  }
  var i_t0 := rank(requested);
  var i_t1 := rank(effective);
  if (i_t0 <= i_t1) {
    assume {:axiom} false;
  }
  if (justification == "") {
    assume {:axiom} false;
  }
  var i_t2 := askUser(justification);
  var outcome := i_t2;
  match outcome {
    case allowed_once =>
      return requested;
    case rejected =>
      assume {:axiom} false;
    case cancelled =>
      assume {:axiom} false;
  }
}

method grantedRank(request: Request) returns (res: int)
  ensures (res >= rank(request.effective))
{
  var i_t3 := approve(request);
  var granted := i_t3;
  var i_t4 := rank(granted);
  return i_t4;
}
