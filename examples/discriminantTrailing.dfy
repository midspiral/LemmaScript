// Generated by lsc from discriminantTrailing.ts

datatype Shape = circle | square | triangle

function classify(s: Shape): string
{
  if s.circle? then
    "round"
  else
    if s.square? then
      "boxy"
    else
      "other"
}

method tally(s: Shape) returns (res: int)
  ensures (res >= 10)
{
  var n := 0;
  if s.circle? {
    n := 1;
  }
  if s.square? {
    n := 2;
  }
  return (n + 10);
}
