  var result: seq<TaskId> := [];
  var i := 0;
  while (i < |lane.value|)
    invariant (i >= 0)
    invariant (i <= |lane.value|)
    invariant (|result| <= i)
  {
    var task := (if lane.value[i] in m.taskData then Some(m.taskData[lane.value[i]]) else None);
    if (task.Some? && !(task.value.deleted)) {
      result := (result + [lane.value[i]]);
    }
    i := (i + 1);
  }
  return result;
}

