}

function clampedSum(a: int, b: int, limit: int): int
  requires (limit >= 0)
{
  var x := addTwice(a);
  var y := increment(b);
  var sum := (x + y);
  if (sum < 0) then
    0
  else
    if (sum > limit) then
      limit
    else
      sum
}

lemma clampedSum_ensures(a: int, b: int, limit: int)
