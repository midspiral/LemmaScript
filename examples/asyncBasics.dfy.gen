method countUp(n: int) returns (res: int)
  requires (n >= 0)
  ensures (res == n)
{
  var total := 0;
  var i := 0;
  while (i < n)
    invariant (0 <= i)
    invariant (i <= n)
    invariant (total == i)
    decreases (n - i)
  {
    total := increment(total);
    i := (i + 1);
  }
  return total;
}
