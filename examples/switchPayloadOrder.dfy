// Generated by lsc from switchPayloadOrder.ts
// lsc options: string-semantics=javascript-utf16

predicate JSStringLt(s: string, t: string)
  decreases |s|
{
  if |s| == 0 then |t| > 0
  else if |t| == 0 then false
  else if s[0] != t[0] then s[0] < t[0]
  else JSStringLt(s[1..], t[1..])
}

datatype Deadline = Deadline(day: string)

datatype Bound = always(value_always: bool) | until(value_until: Deadline)

function before(bound: Bound, cutoff: string): bool
{
  match bound {
    case always(i_bound_value) =>
      false
    case until(i_bound_value) =>
      JSStringLt(i_bound_value.day, cutoff)
  }
}

function beforeDeadline(day: string, cutoff: string): bool
{
  before(until(Deadline(day)), cutoff)
}

lemma beforeDeadline_ensures(day: string, cutoff: string)
  ensures (beforeDeadline(day, cutoff) == JSStringLt(day, cutoff))
{
}
