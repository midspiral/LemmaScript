method carryScan(digits: seq<int>) returns (res: int)
  requires (|digits| > 0)
  ensures (res >= -1)
  ensures (res < |digits|)
{
  var i := (|digits| - 1);
  var carry := 1;
  while ((i >= 0) && (carry != 0))
    invariant (i >= -1)
    invariant (i < |digits|)
    decreases (i + 1)
  {
    if (digits[i] == 0) {
      carry := 0;
    }
    i := (i - 1);
  }
  return i;
}
