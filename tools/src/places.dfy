function stepsMayMatch(a: PlaceStep, b: PlaceStep): bool
{
  match a {
    case field(i_a_field) =>
      match b {
        case field(i_b_field) =>
          (i_a_field == i_b_field)
        case _ =>
          false
      }
    case variant(i_a_tag) =>
      match b {
        case variant(i_b_tag) =>
          (i_a_tag == i_b_tag)
        case _ =>
          false
      }
    case unwrap =>
      b.unwrap?
    case index(i_a_idxTag) =>
      b.index?
    case mapKey(i_a_keyTag) =>
      b.mapKey?
  }
}

method placesMayOverlap(a: PlacePath, b: PlacePath) returns (res: bool)
  ensures ((a.root != b.root) ==> !(res))
{
  if (a.root != b.root) {
    return false;
  }
  var limit := (if (|a.steps| < |b.steps|) then |a.steps| else |b.steps|);
  var i := 0;
  while (i < limit)
    invariant (0 <= i)
    invariant (i <= limit)
  {
    var i_t0 := stepsMayMatch(a.steps[i], b.steps[i]);
    if !(i_t0) {
      return false;
    }
    i := (i + 1);
  }
  return true;
}

