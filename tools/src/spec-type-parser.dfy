    case ok(_, _, _) =>
      if (res.nextPos != |tokens|) {
        return SpecParseResult.err((("Unexpected trailing token '" + tokens[res.nextPos].text) + "' in type annotation"));
      }
      return res;
  }
}

method parseSpecTypeKernel(input: string) returns (res: SpecParseResult)
