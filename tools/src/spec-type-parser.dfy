method parseSpecTypeTokens(tokens: seq<SpecTypeToken>) returns (res': SpecParseResult)
  ensures ((|tokens| == 0) ==> res'.err?)
  ensures (match res' { case ok(i_result_ty, i_result_raw, i_result_nextPos) => (i_result_nextPos == |tokens|) case _ => true })
{
  if (|tokens| == 0) {
