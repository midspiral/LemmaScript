  var rest := i_t121;
  return ConstantsOut(([constants[0].(value := v.expr)] + rest.constants), rest.ctx);
}

method narrowFunctions(fns: seq<TFunction>, ctx: CondCtx) returns (res: FunctionsOut)
{
