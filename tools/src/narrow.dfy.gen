method narrowModule(mod: TModule) returns (res: TModule)
{
  var ctx := CondCtx(mod.typeDecls, 0);
  var i_t126 := narrowConstants(mod.constants, ctx);
  var consts := i_t126;
  var i_t127 := narrowFunctions(mod.functions, consts.ctx);
  var fns := i_t127;
